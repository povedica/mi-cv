cv.reflexionia.com {
	root * /etc/caddy/sites/mi-cv/current
	encode zstd gzip
	@profileMarkdown path /index.md /en/index.md
	header @profileMarkdown Content-Type "text/markdown; charset=utf-8"
	@agentIndex path /llms.txt /en/llms.txt
	header @agentIndex Content-Type "text/plain; charset=utf-8"
	@pages path / /en/ /interview/ /en/interview/
	header @pages Cache-Control "public, max-age=0, s-maxage=300"
	handle /_astro/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /etc/caddy/sites/mi-cv/assets
		file_server
	}
	handle_path /media/* {
		route {
			header +Vary "Referer, Origin"
			@denied {
				not header Referer https://cv.reflexionia.com/*
			}
			respond @denied 403

			@foreignOrigin {
				header Origin *
				not header Origin https://cv.reflexionia.com
			}
			respond @foreignOrigin 403

			@playlist path_regexp ^/avatar/v[0-9]+/(master|(?:1080p|720p|480p)/index)\.m3u8$
			@segment path_regexp ^/avatar/v[0-9]+/(?:1080p|720p|480p)/[0-9]+\.ts$
			@initialization path_regexp ^/avatar/v[0-9]+/(?:1080p|720p|480p)/init_[0-2]\.mp4$
			@fragment path_regexp ^/avatar/v[0-9]+/(?:1080p|720p|480p)/[0-9]+\.m4s$
			root * /etc/caddy/sites/mi-cv-media
			handle @playlist {
				header Content-Type application/vnd.apple.mpegurl
				header Cache-Control "private, max-age=60"
				file_server
			}
			handle @segment {
				header Content-Type video/mp2t
				header Cache-Control "private, max-age=31536000, immutable"
				file_server
			}
			handle @initialization {
				header Content-Type video/mp4
				header Cache-Control "private, max-age=31536000, immutable"
				file_server
			}
			handle @fragment {
				header Content-Type video/iso.segment
				header Cache-Control "private, max-age=31536000, immutable"
				file_server
			}
			respond 404
		}
	}
	handle {
		file_server
	}
}
