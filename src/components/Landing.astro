---
import { Image } from 'astro:assets';
import portrait from '../assets/pablo-portrait.jpg';
import SiteHead from './SiteHead.astro';
import ThemeSelect from './ThemeSelect.astro';
import LandingCards from './LandingCards.astro';
import es from '../content/landing/es.json';
import en from '../content/landing/en.json';
import '../styles/global.css';

interface Props {
  locale: 'es' | 'en';
}

const { locale } = Astro.props;
const isSpanish = locale === 'es';
const copy = isSpanish ? es : en;
const home = isSpanish ? '/' : '/en/';
const interview = isSpanish ? '/interview/' : '/en/interview/';
const otherLocale = isSpanish ? 'en' : 'es';
const cvLocales = [locale, otherLocale] as const;
const otherHome = isSpanish ? '/en/' : '/';
const otherLanguageLabel = isSpanish ? 'Read in English' : 'Leer en español';
const [hero, achievements, focus, ai, experience, projects, education, talks, skills, languages, about, teaser, contact] = copy.ids;
const navIds = [experience, projects, ai, talks, contact];
const linkedin = 'https://www.linkedin.com/in/pablo-poveda-ortega/';
const github = 'https://github.com/povedica';
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Pablo Poveda Ortega',
  jobTitle: 'Engineering Manager',
  address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
  sameAs: [linkedin, github],
};
const talkUrls = [
  'https://wordpress.tv/2017/05/16/pablo-poveda-el-factor-humano/',
  'https://wordpress.tv/2017/10/15/pablo-poveda-kiss-cultura-de-plugins-buenas-practicas/',
  'https://wordpress.tv/2018/11/26/pablo-poveda-y-pablo-lopez-trabajo-en-equipo-cuando-cada-maestrillo-tiene-su-librillo/',
  'https://wordpress.tv/2019/04/27/cierre-wordcamp-madrid-2019/',
  'https://wordpress.tv/2022/11/22/hablemos-de-rendimiento/',
];
const cv = {
  es: '/cv/Pablo-Poveda-Ortega-CV-ES.pdf',
  en: '/cv/Pablo-Poveda-Ortega-CV-EN.pdf',
};
const cvLabels = {
  es: 'Descargar CV en PDF (español)',
  en: 'Download CV in PDF (English)',
};
const showLocalCv = import.meta.env.PUBLIC_MI_CV_PREVIEW_PDFS === '1';
---
<!doctype html>
<html lang={locale} data-analytics-page="home">
  <SiteHead title={copy.title} description={copy.description}>
    <link rel="canonical" href={`https://cv.reflexionia.com${isSpanish ? '/' : '/en/'}`} />
    <link rel="alternate" hreflang="es" href="https://cv.reflexionia.com/" />
    <link rel="alternate" hreflang="en" href="https://cv.reflexionia.com/en/" />
    <link rel="alternate" hreflang="x-default" href="https://cv.reflexionia.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={copy.openGraph.title} />
    <meta property="og:description" content={copy.openGraph.description} />
    <meta property="og:url" content={`https://cv.reflexionia.com${home}`} />
    <meta property="og:image" content="https://cv.reflexionia.com/og.jpg" />
    <meta property="og:image:alt" content={copy.openGraph.imageAlt} />
    <meta property="og:locale" content={isSpanish ? 'es_ES' : 'en_GB'} />
    <meta property="og:locale:alternate" content={isSpanish ? 'en_GB' : 'es_ES'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person).replaceAll('<', '\\u003c')} />
  </SiteHead>
  <body>
    <a class="skip-link" href="#main-content">{copy.skip}</a>
    <div class="page-glow"></div>
    <header class="site-header shell">
      <a class="brand" href={home}><span class="brand-mark" aria-hidden="true">PP</span>{copy.name}</a>
      <nav aria-label={isSpanish ? 'Navegación principal' : 'Main navigation'}>
        {copy.nav.map((label, index) => <a href={`#${navIds[index]}`}>{label}</a>)}
      </nav>
      <div class="header-actions">
        <ThemeSelect locale={locale} />
        <a href={otherHome} hreflang={otherLocale} lang={otherLocale} aria-label={otherLanguageLabel} data-analytics-action="language-change">{otherLocale.toUpperCase()}</a>
        <a class="button button-primary nav-cta" href={interview} data-interview-placement="navigation">{copy.interviewLabel}</a>
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <section class="hero shell" id={hero}>
        <div class="hero-copy">
          <div class="eyebrow"><span class="eyebrow-dot"></span>{copy.eyebrow}</div>
          <h1>{copy.name}<em>{copy.headline}</em></h1>
          <p class="lead">{copy.lead}</p>
          <div class="hero-actions">
            <a class="button button-primary button-large" data-interview-placement="hero" href={interview}>{copy.interviewLabel}</a>
            {showLocalCv && <a class="button button-secondary button-large" href={cv[locale]} hreflang={locale} download data-analytics-action="cv-download">{copy.download}</a>}
            <a class="button button-secondary button-large" href={linkedin} target="_blank" rel="noopener" data-analytics-action="linkedin-click">LinkedIn</a>
            <a class="button button-secondary button-large" href={`#${contact}`} data-analytics-action="contact-click">{copy.contactLabel}</a>
          </div>
          <p class="hero-note">{copy.location}</p>
        </div>
        <figure class="hero-stage">
          <div class="stage-content">
            <Image src={portrait} alt={copy.portraitAlt} class="hero-portrait" width={1200} widths={[320, 480, 640, 800, 960, 1200]} sizes="(max-width: 760px) calc(100vw - 56px), (max-width: 1544px) 50vw, 720px" format="webp" priority />
            <figcaption class="stage-overlay portrait-name">{copy.portraitLabel}</figcaption>
          </div>
        </figure>
      </section>
      <LandingCards id={achievements} section={copy.achievements} />
      <LandingCards id={focus} section={copy.focus} />
      <LandingCards id={ai} section={copy.ai} />
      <section class="topics shell" id={experience}>
        <div class="section-header"><h2>{copy.experience.title}</h2><p>{copy.experience.intro}</p></div>
        <ol class="timeline">
          {copy.experience.roles.map(role => (
            <li class="topic">
              <h3>{role.title}</h3>
              <p>{role.period}</p>
              <ul>{role.items.map(item => <li>{item}</li>)}</ul>
              {role.details.length > 0 && (
                <details>
                  <summary>{copy.experience.more}</summary>
                  <ul>{role.details.map(item => <li>{item}</li>)}</ul>
                </details>
              )}
            </li>
          ))}
        </ol>
      </section>
      <LandingCards id={projects} section={copy.projects} />
      <LandingCards id={education} section={copy.education} />
      <section class="topics shell" id={talks}>
        <div class="section-header"><h2>{copy.talks.title}</h2></div>
        <div class="topic-grid">
          <article class="topic"><h3>{copy.talks.highlights[0].title}</h3><p>{copy.talks.highlights[0].text}</p></article>
          <article class="topic"><h3>{copy.talks.heading}</h3><ul>{copy.talks.labels.map((label, index) => <li><a class="inline-link" href={talkUrls[index]}>{label}</a></li>)}</ul></article>
          <article class="topic"><h3>{copy.talks.highlights[1].title}</h3><p>{copy.talks.highlights[1].text}</p></article>
        </div>
      </section>
      <LandingCards id={skills} section={copy.skills} />
      <section class="statement shell" id={languages}>
        <h2>{copy.languages.title}</h2>
        <ul>{copy.languages.items.map(item => <li>{item}</li>)}</ul>
      </section>
      <section class="statement shell" id={about}>
        <h2>{copy.about.title}</h2>
        <div>{copy.about.items.map(item => <p>{item}</p>)}</div>
      </section>
      <section class="project shell" id={teaser}>
        <div>
          <h2>{copy.interview.title}</h2>
          <p>{copy.interview.text}</p>
          <a class="inline-link" data-interview-placement="project" href={interview}>{copy.interview.cta}</a>
        </div>
      </section>
      <section class="statement shell" id={contact}>
        <h2>{copy.contact.title}</h2>
        <div>
          <p>{copy.contact.text}</p>
          <p>{copy.contact.note}</p>
          <div class="hero-actions">
            {showLocalCv && cvLocales.map(language => (
              <a class="button button-secondary" href={cv[language]} hreflang={language} lang={language} download data-analytics-action="cv-download">{cvLabels[language]}</a>
            ))}
            <a class="button button-primary" href={linkedin} target="_blank" rel="noopener" data-analytics-action="linkedin-click">{copy.contact.linkedin}</a>
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer shell">
      <span>© {new Date().getFullYear()} {copy.name}</span>
      <span>{isSpanish ? 'Web hecha con Astro.' : 'Built with Astro.'}</span>
      <div class="footer-links">
        <a href={linkedin} target="_blank" rel="noopener" data-analytics-action="linkedin-click">LinkedIn</a>
        <a href={github}>GitHub</a>
        {showLocalCv && cvLocales.map(language => (
          <a href={cv[language]} hreflang={language} download data-analytics-action="cv-download">CV ({language.toUpperCase()})</a>
        ))}
        <a href={otherHome} hreflang={otherLocale} lang={otherLocale} data-analytics-action="language-change">{isSpanish ? 'English' : 'Español'}</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .header-actions,
  .footer-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-stage {
    margin: 0;
  }

  .timeline {
    display: grid;
    gap: 16px;
    padding-inline-start: 1.6em;
  }

  summary {
    cursor: pointer;
    color: var(--accent);
    width: fit-content;
  }
</style>
