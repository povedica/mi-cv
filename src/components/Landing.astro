---
import PortfolioLayout from './PortfolioLayout.astro';
import AvatarVideo from './AvatarVideo.astro';
import LandingContactActions from './LandingContactActions.astro';
import UnavailableInterview from './UnavailableInterview.astro';
import LandingSectionTitle from './LandingSectionTitle.astro';
import LandingRoles from './LandingRoles.astro';
import LandingCompany from './LandingCompany.astro';
import { cv, linkedin, profileCopy, talkUrls } from '../data/public-profile';

interface Props {
  locale: 'es' | 'en';
}

const { locale } = Astro.props;
const isSpanish = locale === 'es';
const copy = profileCopy[locale];
const [hero, focus, ai, experience, projects, education, talks, skills, languages, about, teaser, contact] = copy.ids;
const [vassManager, vassLead, ...otherRoles] = copy.experience.roles;
const cvHint = isSpanish ? 'abre en una pestaña nueva' : 'opens in a new tab';
const cvLabels = {
  es: `CV (ES) · PDF, ${cvHint}`,
  en: `CV (EN) · PDF, ${cvHint}`,
};
---
<PortfolioLayout {locale}>
  <section class="landing-hero" id={hero} aria-labelledby="landing-name">
    <div class="landing-wrap landing-hero-main">
      <div class="landing-hero-copy">
        <h1 id="landing-name">{copy.name}</h1>
        <p class="landing-role">{copy.headline}</p>
        <div class="landing-lead">
          {copy.lead.map(paragraph => <p>{paragraph}</p>)}
        </div>
        <div class="landing-hero-actions">
          <LandingContactActions {linkedin} {cv} {cvLabels} />
          <UnavailableInterview label={copy.interviewLabel} status={copy.interview.status} />
        </div>
      </div>
      <div class="landing-portrait">
        <AvatarVideo locale={locale} placement="hero" />
      </div>
    </div>
    <div class="landing-hero-foot"><div class="landing-wrap"><span>{copy.eyebrow}</span><span>{copy.location}</span></div></div>
  </section>

  <section class="landing-section" id={focus}>
    <div class="landing-wrap landing-split">
      <LandingSectionTitle title={copy.focus.title} intro={copy.focus.intro} />
      <div class="landing-areas">
        {copy.focus.items.map(item => <article><h3>{item.title}</h3><p>{item.text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="landing-section landing-band" id={ai}>
    <div class="landing-wrap landing-split">
      <LandingSectionTitle title={copy.ai.title} />
      <div>
        <p class="landing-ai-intro">{copy.ai.intro}</p>
        <article class="landing-ai-feature"><h3>{copy.ai.items[0].title}</h3><p>{copy.ai.items[0].text}</p></article>
        <div class="landing-ai-grid">
          {copy.ai.items.slice(1).map(item => (
            <article>
              <h3>{item.href ? <a href={item.href} target="_blank" rel="noopener">{item.title}</a> : item.title}</h3>
              <p>{item.text}</p>
              {item.demo && (
                <div class="landing-project-demo">
                  <h4>{item.demo.label}</h4>
                  <dl>
                    <div><dt>{item.demo.emailLabel}</dt><dd><code>{item.demo.email}</code></dd></div>
                    <div><dt>{item.demo.passwordLabel}</dt><dd><code>{item.demo.password}</code></dd></div>
                  </dl>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="landing-section" id={experience}>
    <div class="landing-wrap">
      <LandingSectionTitle title={copy.experience.title} />
      <ol class="landing-timeline" role="list">
        <li>
          <LandingCompany company={vassManager.company} sector={vassManager.sector} period={copy.experience.vassPeriod} context={vassManager.context} />
          <LandingRoles roles={[vassManager, vassLead]} group />
        </li>
        {otherRoles.map(role => (
          <li>
            <LandingCompany company={role.company} sector={role.sector} period={role.period} context={role.context} />
            <LandingRoles roles={[role]} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="landing-section" id={projects}>
    <div class="landing-wrap">
      <LandingSectionTitle title={copy.projects.title} intro={copy.projects.intro} wide />
      <div class="landing-cases">
        {copy.projects.items.map(item => <article><h3>{item.title}</h3><p>{item.text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="landing-section" id={skills}>
    <div class="landing-wrap">
      <LandingSectionTitle title={copy.skills.title} />
      <div class="landing-skills">
        {copy.skills.items.map(item => (
          <div class="landing-profile-item">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="landing-section" id={education}>
    <div class="landing-wrap">
      <LandingSectionTitle title={copy.education.title} />
      {copy.education.items.map(item => (
        <article class="landing-education-entry">
          <div class="landing-education-metadata">
            <p class="landing-period">{item.period}</p>
            <p class="landing-education-institution">{item.institution}</p>
            {item.detail && <p class="landing-education-detail">{item.detail}</p>}
          </div>
          <div class="landing-education-content">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            {item.publication && (
              <a class="landing-education-publication" href={item.publication.href} target="_blank" rel="noopener">{item.publication.label}</a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="landing-section" id={languages}>
    <div class="landing-wrap">
      <LandingSectionTitle title={copy.languages.title} />
      <ul class="landing-languages" role="list">
        {copy.languages.items.map(item => <li><span class="landing-language-code" aria-hidden="true">{item.locale.toUpperCase()}</span>{item.text}</li>)}
      </ul>
    </div>
  </section>

  <section class="landing-section" id={about}>
    <div class="landing-wrap">
      <LandingSectionTitle title={copy.about.title} />
      <blockquote>“{copy.about.quote}”</blockquote>
      <div class="landing-about">{copy.about.items.map(item => <p>{item}</p>)}</div>
    </div>
  </section>

  <section class="landing-section" id={talks}>
    <div class="landing-wrap landing-split">
      <LandingSectionTitle title={copy.talks.title} />
      <div>
          <div class="landing-profile-item"><h3>{copy.talks.highlights[0].title}</h3><p>{copy.talks.highlights[0].text}</p></div>
          <div class="landing-profile-item"><h3>{copy.talks.heading}</h3><ul>{copy.talks.labels.map((label, index) => <li><a href={talkUrls[index]}>{label}</a></li>)}</ul></div>
          <div class="landing-profile-item"><h3>{copy.talks.highlights[1].title}</h3><p>{copy.talks.highlights[1].text}</p></div>
      </div>
    </div>
  </section>

  <div class="landing-section">
    <div class="landing-wrap landing-end">
      <section id={teaser}>
        <LandingSectionTitle title={copy.interview.title} />
        <p>{copy.interview.text}</p>
        <ul class="landing-questions" role="list">
          {copy.suggestions.map(question => (
            <li>{question}</li>
          ))}
        </ul>
        <UnavailableInterview label={copy.interviewLabel} status={copy.interview.status} />
      </section>
      <section id={contact}>
        <h2>{copy.contact.title}</h2>
        <p>{copy.contact.text}</p>
        <p>{copy.contact.note}</p>
        <LandingContactActions {linkedin} {cv} {cvLabels} />
      </section>
    </div>
  </div>
</PortfolioLayout>
