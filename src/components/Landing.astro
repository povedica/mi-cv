---
import AvatarVideo from './AvatarVideo.astro';
import SiteHead from './SiteHead.astro';
import ThemeSelect from './ThemeSelect.astro';
import LandingSectionTitle from './LandingSectionTitle.astro';
import LandingRoles from './LandingRoles.astro';
import LandingCompany from './LandingCompany.astro';
import es from '../content/landing/es.json';
import en from '../content/landing/en.json';
import '../styles/landing.css';

interface Props {
  locale: 'es' | 'en';
}

const { locale } = Astro.props;
const isSpanish = locale === 'es';
const copy = isSpanish ? es : en;
const home = isSpanish ? '/' : '/en/';
const interview = isSpanish ? '/interview/' : '/en/interview/';
const otherLocale = isSpanish ? 'en' : 'es';
const cvLocales = [locale, otherLocale] as const;
const otherHome = isSpanish ? '/en/' : '/';
const otherLanguageLabel = isSpanish ? 'EN · Read in English' : 'ES · Leer en español';
const [hero, focus, ai, experience, projects, education, talks, skills, languages, about, teaser, contact] = copy.ids;
const [vassManager, vassLead, ...otherRoles] = copy.experience.roles;
const navIds = [experience, projects, ai, talks, contact];
const linkedin = 'https://www.linkedin.com/in/pablo-poveda-ortega/';
const github = 'https://github.com/povedica';
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Pablo Poveda Ortega',
  jobTitle: 'Engineering Manager',
  address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
  sameAs: [linkedin, github],
};
const talkUrls = [
  'https://wordpress.tv/2017/05/16/pablo-poveda-el-factor-humano/',
  'https://wordpress.tv/2017/10/15/pablo-poveda-kiss-cultura-de-plugins-buenas-practicas/',
  'https://wordpress.tv/2018/11/26/pablo-poveda-y-pablo-lopez-trabajo-en-equipo-cuando-cada-maestrillo-tiene-su-librillo/',
  'https://wordpress.tv/2019/04/27/cierre-wordcamp-madrid-2019/',
  'https://wordpress.tv/2022/11/22/hablemos-de-rendimiento/',
];
const cv = {
  es: '/cv/Pablo-Poveda-Ortega-CV-ES.pdf',
  en: '/cv/Pablo-Poveda-Ortega-CV-EN.pdf',
};
const cvLabels = {
  es: 'Descargar CV en PDF (español)',
  en: 'Download CV in PDF (English)',
};
---
<!doctype html>
<html lang={locale} data-analytics-page="home">
  <SiteHead title={copy.title} description={copy.description}>
    <link rel="canonical" href={`https://cv.reflexionia.com${isSpanish ? '/' : '/en/'}`} />
    <link rel="alternate" hreflang="es" href="https://cv.reflexionia.com/" />
    <link rel="alternate" hreflang="en" href="https://cv.reflexionia.com/en/" />
    <link rel="alternate" hreflang="x-default" href="https://cv.reflexionia.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={copy.openGraph.title} />
    <meta property="og:description" content={copy.openGraph.description} />
    <meta property="og:url" content={`https://cv.reflexionia.com${home}`} />
    <meta property="og:image" content="https://cv.reflexionia.com/og.jpg" />
    <meta property="og:image:alt" content={copy.openGraph.imageAlt} />
    <meta property="og:locale" content={isSpanish ? 'es_ES' : 'en_GB'} />
    <meta property="og:locale:alternate" content={isSpanish ? 'en_GB' : 'es_ES'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person).replaceAll('<', '\\u003c')} />
  </SiteHead>
  <body class="landing">
    <a class="landing-skip" href="#main-content">{copy.skip}</a>
    <header class="landing-nav">
      <div class="landing-wrap">
        <a class="landing-brand" href={home} aria-label={copy.name + " · " + copy.headline}>
          <span class="landing-brand-name"><span>{copy.name}</span><span aria-hidden="true">PP</span><b aria-hidden="true">.</b></span>
          <span class="landing-brand-title"><span>{copy.headline}</span><span>{copy.portraitLabel}</span></span>
        </a>
        <nav aria-label={isSpanish ? 'Navegación principal' : 'Main navigation'}>
          {copy.nav.map((label, index) => <a href={`#${navIds[index]}`}>{label}</a>)}
        </nav>
        <div class="landing-nav-actions">
          <a class="landing-button landing-linkedin" href={linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" data-analytics-action="linkedin-click">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M4 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM2.5 9h3v12h-3zm6 0h3v1.6a4 4 0 0 1 3.6-1.9c3.8 0 4.4 2.5 4.4 5.8V21h-3v-6c0-1.9-.4-3.4-2.4-3.4s-2.6 1.5-2.6 3.3V21h-3z"/></svg>
            <span>LinkedIn</span>
          </a>
          <a class="landing-button landing-nav-cv" href={cv[locale]} target="_blank" rel="noopener" hreflang={locale} data-analytics-action="cv-download"><span>{copy.download}</span><span>CV</span></a>
          <a class="landing-button landing-primary" href={interview} data-interview-placement="navigation">{copy.interviewLabel}</a>
          <a class="landing-lang" href={otherHome} hreflang={otherLocale} lang={otherLocale} aria-label={otherLanguageLabel} data-analytics-action="language-change">
            <span aria-hidden="true">{isSpanish ? '🇬🇧' : '🇪🇸'}</span>{otherLocale.toUpperCase()}
          </a>
        </div>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <section class="landing-hero" id={hero} aria-labelledby="landing-name">
        <div class="landing-wrap landing-hero-main">
          <div class="landing-hero-copy">
            <h1 id="landing-name">{copy.name}</h1>
            <p class="landing-role">{copy.headline}</p>
            <p class="landing-lead">{copy.lead}</p>
            <div class="landing-actions">
              <a class="landing-button landing-primary" data-interview-placement="hero" href={interview}>{copy.interviewLabel} <span aria-hidden="true">→</span></a>
              <div class="landing-cv-group">
                {cvLocales.map((language, index) => (
                  <a class="landing-button" href={cv[language]} hreflang={language} lang={language} aria-label={cvLabels[language]} download data-analytics-action="cv-download">
                    {index === 0 && `${copy.download} · `}{language.toUpperCase()}
                  </a>
                ))}
              </div>
              <a class="landing-button" href={linkedin} target="_blank" rel="noopener" data-analytics-action="linkedin-click">LinkedIn</a>
              <a href={`#${contact}`} data-analytics-action="contact-click">{copy.contactLabel}</a>
            </div>
          </div>
          <div class="landing-portrait">
            <AvatarVideo locale={locale} placement="hero" />
          </div>
        </div>
        <div class="landing-hero-foot"><div class="landing-wrap"><span>{copy.eyebrow}</span><span>{copy.location}</span></div></div>
      </section>

      <section class="landing-section" id={focus}>
        <div class="landing-wrap landing-split">
          <LandingSectionTitle title={copy.focus.title} intro={copy.focus.intro} />
          <div class="landing-areas">
            {copy.focus.items.map(item => <article><h3>{item.title}</h3><p>{item.text}</p></article>)}
          </div>
        </div>
      </section>

      <section class="landing-section landing-band" id={ai}>
        <div class="landing-wrap landing-split">
          <LandingSectionTitle title={copy.ai.title} />
          <div>
            <p class="landing-ai-intro">{copy.ai.intro}</p>
            <article class="landing-ai-feature"><h3>{copy.ai.items[0].title}</h3><p>{copy.ai.items[0].text}</p></article>
            <div class="landing-ai-grid">
              {copy.ai.items.slice(1).map(item => (
                <article><h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3><p>{item.text}</p></article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="landing-section" id={experience}>
        <div class="landing-wrap">
          <LandingSectionTitle title={copy.experience.title} />
          <ol class="landing-timeline" role="list">
            <li>
              <LandingCompany company={vassManager.company} period={copy.experience.vassPeriod} context={vassManager.context} />
              <LandingRoles roles={[vassManager, vassLead]} group />
            </li>
            {otherRoles.map(role => (
              <li>
                <LandingCompany company={role.company} period={role.period} context={role.context} />
                <LandingRoles roles={[role]} />
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="landing-section" id={projects}>
        <div class="landing-wrap">
          <LandingSectionTitle title={copy.projects.title} intro={copy.projects.intro} wide />
          <div class="landing-cases">
            {copy.projects.items.map(item => <article><h3>{item.title}</h3><p>{item.text}</p></article>)}
          </div>
        </div>
      </section>

      <section class="landing-section">
        <div class="landing-wrap">
          <LandingSectionTitle title={copy.profileLabel} />
          <div class="landing-profile">
            <div>
              <section id={skills}>
                <h3>{copy.skills.title}</h3>
                {copy.skills.items.map(item => <div class="landing-profile-item"><h4>{item.title}</h4><p>{item.text}</p></div>)}
              </section>
              <section id={education}>
                <h3>{copy.education.title}</h3>
                {copy.education.items.map(item => <div class="landing-profile-item"><h4>{item.title}</h4><p>{item.text}</p></div>)}
              </section>
            </div>
            <div>
              <section id={talks}>
                <h3>{copy.talks.title}</h3>
                <div class="landing-profile-item"><h4>{copy.talks.highlights[0].title}</h4><p>{copy.talks.highlights[0].text}</p></div>
                <div class="landing-profile-item"><h4>{copy.talks.heading}</h4><ul>{copy.talks.labels.map((label, index) => <li><a href={talkUrls[index]}>{label}</a></li>)}</ul></div>
                <div class="landing-profile-item"><h4>{copy.talks.highlights[1].title}</h4><p>{copy.talks.highlights[1].text}</p></div>
              </section>
              <section id={languages}>
                <h3>{copy.languages.title}</h3>
                <ul>{copy.languages.items.map(item => <li>{item}</li>)}</ul>
              </section>
            </div>
          </div>
        </div>
      </section>

      <section class="landing-section" id={about}>
        <div class="landing-wrap">
          <LandingSectionTitle title={copy.about.title} />
          <blockquote>“{copy.about.quote}”</blockquote>
          <div class="landing-about">{copy.about.items.map(item => <p>{item}</p>)}</div>
        </div>
      </section>

      <div class="landing-section">
        <div class="landing-wrap landing-end">
          <section id={teaser}>
            <LandingSectionTitle title={copy.interview.title} />
            <p>{copy.interview.text}</p>
            <ul class="landing-questions" role="list">
              {copy.suggestions.map(question => (
                <li><a href={interview + '#chat-preview'} data-interview-placement="project">{question}<span aria-hidden="true">→</span></a></li>
              ))}
            </ul>
            <a class="landing-button landing-primary" data-interview-placement="project" href={interview}>{copy.interview.cta}</a>
          </section>
          <section id={contact}>
            <h2>{copy.contact.title}</h2>
            <p>{copy.contact.text}</p>
            <div class="landing-actions">
              {cvLocales.map(language => (
                <a class="landing-button" href={cv[language]} hreflang={language} lang={language} download data-analytics-action="cv-download">{cvLabels[language]}</a>
              ))}
              <a class="landing-button" href={linkedin} target="_blank" rel="noopener" data-analytics-action="linkedin-click">{copy.contact.linkedin}</a>
            </div>
            <p>{copy.contact.note}</p>
          </section>
        </div>
      </div>
    </main>

    <footer class="landing-footer">
      <div class="landing-wrap">
        <div><strong>{copy.name}</strong><p>{isSpanish ? 'Web hecha con Astro.' : 'Built with Astro.'}</p></div>
        <nav aria-label={isSpanish ? 'Pie de página' : 'Footer'}>
          <a href={linkedin} target="_blank" rel="noopener" data-analytics-action="linkedin-click">LinkedIn</a>
          <a href={github}>GitHub</a>
          {cvLocales.map(language => <a href={cv[language]} hreflang={language} download data-analytics-action="cv-download">CV ({language.toUpperCase()})</a>)}
          <a href={otherHome} hreflang={otherLocale} lang={otherLocale} data-analytics-action="language-change">{isSpanish ? 'English' : 'Español'}</a>
        </nav>
        <ThemeSelect locale={locale} />
      </div>
    </footer>
  </body>
</html>
