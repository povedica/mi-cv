---
interface Role {
  title: string;
  period: string;
  context: string;
  summary: string;
  items: string[];
  tags: string[];
}

interface Props {
  roles: Role[];
  group?: boolean;
}

const { roles, group } = Astro.props;
---
<div class="landing-roles">
  {roles.map(role => (
    <article>
      {group && <p class="landing-period">{role.period}</p>}
      <h3>{role.title}</h3>
      <p class="landing-summary">{role.summary}</p>
      <ul class="landing-points">{role.items.map(item => <li>{item}</li>)}</ul>
      <ul class="landing-tags" role="list">{role.tags.map(tag => <li>{tag}</li>)}</ul>
    </article>
  ))}
</div>
