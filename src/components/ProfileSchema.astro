---
import { profileCopy, profileCreated, profileModified, profileOrigin, talkUrls } from '../data/public-profile';

interface Props {
  locale: 'es' | 'en';
  home: string;
  title: string;
  profile: {
    description: string;
    credentialCategory: string;
    credentialNames: string[];
  };
  linkedin: string;
  github: string;
}

const { locale, home, title, profile, linkedin, github } = Astro.props;
const site = `${profileOrigin}/`;
const url = new URL(home, site).href;
const websiteId = `${site}#website`;
const personId = `${site}#person`;
const lidr = { '@type': 'Organization', name: 'LIDR' };
const unir = { '@type': 'CollegeOrUniversity', name: 'UNIR' };
const credential = (name: string, institution: typeof lidr) => ({
  '@type': 'EducationalOccupationalCredential',
  name,
  credentialCategory: profile.credentialCategory,
  recognizedBy: institution,
});
const copy = profileCopy[locale];
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
function isoMonth(date: string) {
  const [month, year] = date.split(' ');
  const number = months.indexOf(month) + 1;
  if (!number || !/^\d{4}$/.test(year)) throw new Error(`Invalid public experience date: ${date}`);
  return `${year}-${String(number).padStart(2, '0')}`;
}
const career = copy.experience.roles.map((role, index) => {
  const [start, end] = profileCopy.en.experience.roles[index].period.split(' – ');
  return {
    '@type': 'OrganizationRole',
    roleName: role.title,
    startDate: isoMonth(start),
    endDate: isoMonth(end),
    worksFor: { '@type': 'Organization', name: role.company },
  };
});
const wordCamp = {
  '@type': 'Event',
  '@id': 'https://madrid.wordcamp.org/2019/#event',
  name: 'WordCamp Madrid 2019',
  url: 'https://madrid.wordcamp.org/2019/',
  startDate: '2019-04-06',
  endDate: '2019-04-07',
  location: ['La Nave', 'Google for Startups'].map(name => ({
    '@type': 'Place',
    name,
    address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
  })),
};
const talks = copy.talks.labels.map((name, index) => ({
  '@type': 'CreativeWork',
  name,
  url: talkUrls[index],
  contributor: {
    '@type': 'Role',
    roleName: index === 3 ? copy.talks.highlights[0].title : locale === 'es' ? 'Ponente' : 'Speaker',
    contributor: { '@id': personId },
  },
  ...(index === 3 ? { about: { '@id': wordCamp['@id'] } } : {}),
}));
talks.push({
  '@type': 'CreativeWork',
  name: copy.talks.highlights[1].title,
  url: `${url}#${copy.ids[6]}`,
  contributor: {
    '@type': 'Role',
    roleName: locale === 'es' ? 'Ponente' : 'Speaker',
    contributor: { '@id': personId },
  },
});
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': websiteId, url: site, name: 'Pablo Poveda', inLanguage: ['es', 'en'] },
    {
      '@type': 'ProfilePage',
      '@id': `${url}#profile`,
      url,
      name: title,
      isPartOf: { '@id': websiteId },
      dateCreated: profileCreated,
      dateModified: profileModified,
      mainEntity: { '@id': personId },
      inLanguage: locale,
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Pablo Poveda Ortega',
      alternateName: 'Pablo Poveda',
      url,
      image: `${site}pablo-poveda.jpg`,
      jobTitle: 'Engineering Manager',
      description: profile.description,
      address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
      knowsAbout: [
        'Engineering Management', 'Technical Leadership', 'AI Engineering', 'Generative AI',
        'Retrieval-Augmented Generation', 'AI Agents', 'Software Delivery', 'DevOps', 'PHP',
      ],
      knowsLanguage: ['es', 'en'],
      alumniOf: [{ '@type': 'CollegeOrUniversity', name: 'Universidad de Alicante' }, unir, lidr],
      hasCredential: [
        credential(profile.credentialNames[0], lidr),
        credential(profile.credentialNames[1], unir),
      ],
      sameAs: [linkedin, github],
      worksFor: career,
      subjectOf: talks,
    },
    {
      ...wordCamp,
      organizer: {
        '@type': 'Role',
        roleName: copy.talks.highlights[0].title,
        organizer: { '@id': personId },
      },
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(graph).replaceAll('<', '\\u003c')} />
