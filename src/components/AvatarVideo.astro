---
import { Image } from 'astro:assets';
import portrait from '../assets/pablo-portrait-v2.jpg';

interface Props {
  placement?: 'hero' | 'interview';
}

const { placement = 'interview' } = Astro.props;
const isHero = placement === 'hero';
---

<figure class:list={["avatar-video", isHero ? "avatar-hero" : "video-panel"]} data-avatar-video>
  <figcaption class="video-top">Vídeo generado con IA a partir de Pablo</figcaption>
  <div class:list={["avatar-frame", { "stage-content": isHero }]}>
    <Image
      src={portrait}
      alt="Retrato de Pablo Poveda"
      width={1200}
      widths={[320, 480, 640, 800, 960, 1200]}
      sizes={isHero ? "(max-width: 760px) calc(100vw - 56px), (max-width: 1544px) 50vw, 720px" : "(max-width: 760px) calc(100vw - 56px), 44vw"}
      format="webp"
      priority={isHero}
    />
    <video
      aria-label="Vídeo del avatar de Pablo Poveda"
      data-source="/media/avatar/v1/master.m3u8"
      preload="none"
      playsinline
      controlslist="nodownload"
      disablepictureinpicture
    ></video>
  </div>
  <button class="button button-primary" type="button" hidden>Cargar vídeo</button>
  <p role="status"></p>
  <noscript><p>Activa JavaScript para reproducir el vídeo.</p></noscript>
</figure>

<style>
  .avatar-frame {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    background: #273042;
  }

  .avatar-frame::after {
    display: none;
  }

  .avatar-frame:not(.stage-content) {
    aspect-ratio: 4 / 5;
  }

  .avatar-frame img,
  video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .avatar-frame img {
    object-fit: cover;
    object-position: center 32%;
  }

  video {
    visibility: hidden;
    object-fit: contain;
  }

  [data-video-ready] img {
    visibility: hidden;
  }

  [data-video-ready] video {
    visibility: visible;
  }

  .avatar-hero {
    margin: 0;
  }

  button {
    align-self: start;
    margin-top: 12px;
  }

  p:empty {
    display: none;
  }
</style>

<script>
  const player = document.querySelector<HTMLElement>('[data-avatar-video]')!;
  const video = player.querySelector('video')!;
  const load = player.querySelector('button')!;
  const status = player.querySelector('[role="status"]')!;
  const source = video.dataset.source!;
  const frame = video.parentElement!;

  load.hidden = false;
  video.addEventListener('contextmenu', event => event.preventDefault());

  load.addEventListener('click', async () => {
    load.disabled = true;
    status.textContent = 'Cargando vídeo…';
    let destroy = () => {};

    function showVideo() {
      frame.setAttribute('data-video-ready', '');
      video.controls = true;
      load.hidden = true;
      status.textContent = '';
      video.focus();
    }

    function fail() {
      video.removeEventListener('error', fail);
      video.removeEventListener('loadeddata', showVideo);
      frame.removeAttribute('data-video-ready');
      destroy();
      video.removeAttribute('src');
      video.load();
      video.controls = false;
      load.hidden = false;
      load.disabled = false;
      load.focus();
      load.textContent = 'Reintentar carga del vídeo';
      status.textContent = 'El vídeo no está disponible en este momento.';
    }

    video.addEventListener('error', fail, { once: true });
    video.addEventListener('loadeddata', showVideo, { once: true });

    try {
      if (video.canPlayType('application/vnd.apple.mpegurl')) {
        video.src = source;
      } else {
        const { default: Hls } = await import('hls.js/light');
        if (!Hls.isSupported()) {
          video.removeEventListener('error', fail);
          video.removeEventListener('loadeddata', showVideo);
          load.hidden = true;
          status.textContent = 'El navegador no admite este vídeo. Se muestra el retrato de Pablo.';
          return;
        }

        const hls = new Hls();
        destroy = () => hls.destroy();
        hls.on(Hls.Events.ERROR, (_event, data) => {
          if (data.fatal) fail();
        });
        hls.loadSource(source);
        hls.attachMedia(video);
      }

      // Native controls remain available if the browser requires another gesture.
      void video.play().catch(() => {});
    } catch {
      fail();
    }
  });
</script>
