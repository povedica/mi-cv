---
import { Image } from 'astro:assets';
import poster from '../assets/poster-pablo-poveda-vertical.png';

interface Props {
  locale: 'es' | 'en';
  placement?: 'hero' | 'interview';
}

const { locale, placement = 'interview' } = Astro.props;
const isHero = placement === 'hero';
const mediaVersion = locale === 'es' ? 'v2' : 'v3';
const label = (es: string, en: string) => locale === 'es' ? es : en;
const messages = {
  loading: label('Cargando vídeo…', 'Loading video…'),
  retry: label('Reintentar reproducción del vídeo', 'Retry video playback'),
  unavailable: label('El vídeo no está disponible en este momento.', 'The video is currently unavailable.'),
  unsupported: label('El navegador no admite este vídeo. Se muestra el retrato de Pablo.', 'Your browser cannot play this video. Pablo’s portrait is shown.'),
};
---

<figure class:list={["avatar-video", { "avatar-interview": !isHero }]} data-avatar-video data-messages={JSON.stringify(messages)}>
  <figcaption class="avatar-caption">
    {label('Grabación generada con IA a partir de Pablo. La entrevista interactiva sigue en desarrollo.', 'AI-generated recording based on Pablo. The interactive interview is still in development.')}
  </figcaption>
  <div class="avatar-frame">
    <Image
      src={poster}
      alt={label('Retrato de Pablo Poveda', 'Portrait of Pablo Poveda')}
      width={648}
      widths={[288, 360, 432, 504, 576, 648]}
      sizes={isHero ? "(max-width: 900px) min(calc(100vw - 2 * clamp(1rem, 4.5vw, 3rem)), 1240px), min(calc((min(100vw - 2 * clamp(1rem, 4.5vw, 3rem), 1240px) - clamp(1.25rem, 4vw, 4rem)) * .3521), max(220px, calc((100svh - 132px - 2 * clamp(1.65rem, 5svh, 4rem)) * 9 / 16)))" : "(max-width: 414px) calc(100vw - 56px), 380px"}
      format="webp"
      quality={72}
      priority={isHero}
    />
    <video
      aria-label={label('Vídeo del avatar de Pablo Poveda', 'Video of Pablo Poveda’s avatar')}
      data-source={`/media/avatar/${mediaVersion}/master.m3u8`}
      preload="none"
      playsinline
      controlslist="nodownload"
      disablepictureinpicture
    >
      <track kind="captions" src={`/captions/avatar-${mediaVersion}-${locale}.vtt`} srclang={locale} label={label('Español', 'English')} />
    </video>
    <button class="avatar-play" type="button" aria-label={label('Reproducir vídeo', 'Play video')} hidden>
      <span aria-hidden="true"></span>
    </button>
    <div class="avatar-tap-zone" aria-hidden="true"></div>
  </div>
  <p role="status"></p>
  <noscript><p>{label('Activa JavaScript para reproducir el vídeo.', 'Enable JavaScript to play the video.')}</p></noscript>
</figure>

<style>
  .avatar-frame {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    background: #273042;
    aspect-ratio: 9 / 16;
  }

  .avatar-frame img,
  video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .avatar-frame img {
    object-fit: cover;
    object-position: center 32%;
  }

  video {
    visibility: hidden;
    object-fit: cover;
  }

  [data-video-ready] img {
    visibility: hidden;
  }

  [data-video-ready] video {
    visibility: visible;
  }

  .avatar-caption { font-size: .8rem; margin-bottom: .4rem; }

  .avatar-video {
    margin: 0;
  }

  .avatar-interview {
    width: min(100%, 380px);
    align-self: start;
    justify-self: center;
  }

  .avatar-tap-zone { display: none; }

  @media (pointer: coarse) {
    [data-video-ready] .avatar-tap-zone {
      position: absolute;
      inset: 0 0 56px;
      display: block;
      touch-action: manipulation;
    }
  }

  .avatar-play {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: clamp(56px, 8vw, 72px);
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 75%);
    border-radius: 50%;
    background: rgb(11 22 38 / 65%);
    backdrop-filter: blur(6px);
    box-shadow: 0 4px 18px rgb(0 0 0 / 25%), inset 0 1px 0 rgb(255 255 255 / 20%);
    color: #fff;
    cursor: pointer;
  }

  .avatar-play[hidden] {
    display: none;
  }

  .avatar-play:hover:not(:disabled) {
    background: rgb(11 22 38 / 82%);
    border-color: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .avatar-play {
      transition: background-color .18s ease, border-color .18s ease;
    }
  }

  .avatar-play:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }

  .avatar-play:disabled {
    cursor: wait;
  }

  .avatar-play span {
    width: 0;
    height: 0;
    margin-left: 4px;
    border-block: 10px solid transparent;
    border-inline-start: 16px solid currentColor;
  }

  p:empty {
    display: none;
  }
</style>

<script>
  const player = document.querySelector<HTMLElement>('[data-avatar-video]')!;
  const video = player.querySelector('video')!;
  const load = player.querySelector('button')!;
  const status = player.querySelector('[role="status"]')!;
  const messages = JSON.parse(player.dataset.messages!) as Record<'loading' | 'retry' | 'unavailable' | 'unsupported', string>;
  const source = video.dataset.source!;
  const frame = video.parentElement!;

  load.hidden = false;
  video.addEventListener('contextmenu', event => event.preventDefault());

  const tapZone = player.querySelector('.avatar-tap-zone')!;
  tapZone.addEventListener('click', () => {
    if (video.paused) {
      void video.play().catch(() => {});
    } else {
      video.pause();
    }
  });

  load.addEventListener('click', async () => {
    load.disabled = true;
    status.textContent = messages.loading;
    let destroy = () => {};

    function showVideo() {
      frame.setAttribute('data-video-ready', '');
      video.controls = true;
      load.hidden = true;
      status.textContent = '';
      video.focus();
    }

    function fail() {
      video.removeEventListener('error', fail);
      video.removeEventListener('loadeddata', showVideo);
      frame.removeAttribute('data-video-ready');
      destroy();
      video.removeAttribute('src');
      video.load();
      video.controls = false;
      load.hidden = false;
      load.disabled = false;
      load.setAttribute('aria-label', messages.retry);
      load.focus();
      status.textContent = messages.unavailable;
    }

    video.addEventListener('error', fail, { once: true });
    video.addEventListener('loadeddata', showVideo, { once: true });

    try {
      if (video.canPlayType('application/vnd.apple.mpegurl')) {
        video.src = source;
      } else {
        const { default: Hls } = await import('hls.js/light');
        if (!Hls.isSupported()) {
          video.removeEventListener('error', fail);
          video.removeEventListener('loadeddata', showVideo);
          load.hidden = true;
          status.textContent = messages.unsupported;
          return;
        }

        // Keep Firefox's initial seek within the first frame when AAC priming offsets the tracks.
        const hls = new Hls({ startPosition: 0, skipBufferHolePadding: 0.001 });
        destroy = () => hls.destroy();
        hls.on(Hls.Events.ERROR, (_event, data) => {
          if (data.fatal) fail();
        });
        hls.loadSource(source);
        hls.attachMedia(video);
      }

      // Native controls remain available if the browser requires another gesture.
      void video.play().catch(() => {});
    } catch {
      fail();
    }
  });
</script>
