---
import VersionShell from './VersionShell.astro';

interface Props { locale: 'es' | 'en' }
const { locale } = Astro.props;
const es = locale === 'es';
const base = es ? '/versiones/' : '/en/versions/';
const title = es ? 'Versiones' : 'Versions';
---
<VersionShell {locale} title={title + ' · Pablo Poveda'}>
  <a href={es ? '/?lang=es' : '/en/'}>← {es ? 'Volver al portfolio' : 'Back to the portfolio'}</a>
  <h1>{title}</h1>
  <nav aria-label={title}>
    <a href={base + 'tui/'}><strong>Terminal (TUI)</strong><span>{es ? 'Explora el perfil con comandos.' : 'Explore the profile with commands.'}</span></a>
    <a href={base + '90s/'}><strong>{es ? 'Web de los 90' : '90s website'}</strong><span>{es ? 'Recorre el CV como en una página personal de los 90.' : 'Browse the CV on a 90s-style personal homepage.'}</span></a>
  </nav>
</VersionShell>

<style>
  h1 { font-size: clamp(2.5rem, 8vw, 5rem); margin-block: 2rem 1rem; }
  nav { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 1rem; }
  nav a { display: grid; gap: .65rem; padding: 1.4rem; background: var(--surface); border: 1px solid var(--control-border); border-radius: .6rem; text-decoration: none; }
  nav a:hover strong { text-decoration: underline; }
  strong { font-size: 1.35rem; }
  span { color: var(--text); }
</style>
