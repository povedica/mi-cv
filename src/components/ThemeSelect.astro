---
interface Props {
  locale: 'es' | 'en';
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const isSpanish = locale === 'es';
const label = isSpanish ? 'Tema' : 'Theme';
---
<label class:list={['theme-select', { 'theme-select-compact': compact }]} title={compact ? label : undefined} hidden>
  {compact ? (
    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75">
      <circle cx="12" cy="12" r="8.5" />
      <path fill="currentColor" stroke="none" d="M12 3.5a8.5 8.5 0 0 1 0 17Z" />
    </svg>
  ) : <span>{label}</span>}
  <select data-theme-select aria-label={compact ? label : undefined}>
    <option value="system">{isSpanish ? 'Sistema' : 'System'}</option>
    <option value="light">{isSpanish ? 'Claro' : 'Light'}</option>
    <option value="dark">{isSpanish ? 'Oscuro' : 'Dark'}</option>
  </select>
</label>

<style>
  .theme-select:not([hidden]) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
  }

  select {
    min-height: 36px;
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--control-border);
    border-radius: 8px;
    padding-inline: 7px;
  }

  .theme-select-compact:not([hidden]) {
    position: relative;
    justify-content: center;
    flex: 0 0 34px;
    height: 34px;
    border: 1px solid var(--strong-line);
    border-radius: 2px;
    color: var(--text);
  }

  .theme-select-compact:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .theme-select-compact select {
    position: absolute;
    inset: 0;
    width: 100%;
    min-height: 0;
    opacity: 0;
    cursor: pointer;
  }
</style>
